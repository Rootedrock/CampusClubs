# Port the server listens on (default: 4000)
PORT=4000

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=https://rootedrock.github.io,http://localhost:8000,http://127.0.0.1:8000

# Shared secret required (via the x-api-key header) to view/delete suggestions.
# Replace this placeholder with a strong random string.
ADMIN_API_KEY=change-me
