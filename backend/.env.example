# Port the server listens on (default: 4000)
PORT=4000

# Comma-separated list of origins allowed to call the API.
# Add your GitHub Pages origin here for the live site to work, e.g.:
# CORS_ORIGINS=https://rootedrock.github.io,http://localhost:5500
CORS_ORIGINS=

# Shared secret required (via the x-api-key header) to view/delete suggestions.
# Set this to any strong random string.
ADMIN_API_KEY=
